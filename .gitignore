# Data: never committed; fetched by scripts/download/ with SHA-256 checks
/data/

# Results: regenerated by experiments/; only small final tables are tracked
/results/*
!/results/tables/

# Large and binary data formats
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.gz
*.parquet
*.feather
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Manuscript: the LaTeX sources, bibliography, generated macros and IEEE class
# files are not part of this repository; only the figures written by experiments/ are tracked
/paper/*
!/paper/figs/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
